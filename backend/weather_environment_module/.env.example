# Copy this file to .env and adjust as needed.
# The application runs fully offline with DEMO_MODE=true and no other values set.

# --- General ---------------------------------------------------------------
ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO

# --- Provider credentials (optional; only needed with DEMO_MODE=false) -----
# Open-Meteo is free and requires no key; URLs rarely need to change.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_HISTORICAL_URL=https://archive-api.open-meteo.com/v1/archive

# IMD does not offer a simple public JSON API. If your team has
# institutional IMD access, set these and extend app/providers/imd.py.
IMD_API_KEY=
IMD_BASE_URL=https://mausam.imd.gov.in

# NASA POWER is free/no-key and used as a soil-moisture proxy fallback.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal

# Required only if you extend soil_moisture.py to use real SMAP data via
# NASA Earthdata (https://urs.earthdata.nasa.gov/).
NASA_EARTHDATA_TOKEN=

# --- HTTP behaviour ----------------------------------------------------------
HTTP_TIMEOUT_SECONDS=8.0
HTTP_MAX_RETRIES=2

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/environmental_data.db
